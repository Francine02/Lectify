# URL base da API. Em dev local: http://localhost:5000
# Deixe VAZIO e use API_PROXY_TARGET quando for abrir o app por um túnel
# (ngrok) ou pelo celular — veja a seção abaixo.
NEXT_PUBLIC_BASE_URL=

# URL pública do front. Em dev: http://localhost:3000
NEXT_PUBLIC_URL=

# Base das URLs de retorno do checkout — precisa ser https (exigência do
# backend e do Mercado Pago). Em produção, use a mesma de NEXT_PUBLIC_URL.
NEXT_PUBLIC_CHECKOUT_RETURN_URL=

# ---------------------------------------------------------------------
# Testar no celular ou por um túnel (ngrok / cloudflared)
# ---------------------------------------------------------------------
# O navegador do celular não enxerga o "localhost" da sua máquina, e uma
# página https não pode chamar uma API http (conteúdo misto). A saída é o
# front falar com a própria origem e o servidor Next repassar para o Flask:
#
#   NEXT_PUBLIC_BASE_URL=/api
#   API_PROXY_TARGET=http://localhost:5000
#   NEXT_PUBLIC_URL=https://<seu-subdominio>.ngrok-free.app
#   NEXT_PUBLIC_CHECKOUT_RETURN_URL=https://<seu-subdominio>.ngrok-free.app
#
# Assim só a porta 3000 precisa ser exposta.
API_PROXY_TARGET=

# Opcional: IP da máquina na rede local, para abrir pelo celular sem túnel.
# Ex.: 192.168.0.12:3000
DEV_ORIGIN=
